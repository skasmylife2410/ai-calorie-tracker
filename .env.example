# ── AI Calorie Tracker — environment variables ────────────────────────────────
# Copy this file to `.env` for local dev. For production, set the same variables
# in your Vercel project settings (Settings → Environment Variables).
# NEVER commit `.env` — it is gitignored.

# REQUIRED — Google Gemini API key. Powers photo analysis and "describe a meal".
# Get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL — second Gemini key used as automatic failover when the primary key
# hits its daily free-tier quota. Create it in a second Google account/project.
# Leave blank or delete this line if you only have one key.
GEMINI_API_KEY_BACKUP=

# OPTIONAL — Supabase cloud sync (backs up your data across devices).
# Without these the app still works fully — data just lives in your browser only.
# Setup: create a free project at https://supabase.com, run supabase/0001_snapcal_schema.sql
# in the SQL Editor, then copy these two values from Project Settings → API.
# The service-role key is server-side only (used by /api/sync) and never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RECOMMENDED — USDA FoodData Central key for food search (/api/foods). Free, instant:
# https://api.data.gov/signup — without it search falls back to the shared DEMO_KEY,
# which allows only a handful of searches an hour.
USDA_API_KEY=

# OPTIONAL but strongly recommended before deploying — a passcode that gates the
# API endpoints so strangers can't burn your Gemini quota or read/write your data.
# Pick any string (e.g. a 6-digit PIN). The app prompts for it on first load.
# Leave blank for local dev to skip the passcode screen.
APP_TOKEN=
